# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). .env is gitignored; this template is not.
#
# Both values are inlined into the app bundle at build time (that's what the
# EXPO_PUBLIC_ prefix means), so only ever put the publishable/anon key here —
# never the service_role / secret key. Row Level Security on the database is
# what actually protects user data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
